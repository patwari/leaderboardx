APP_NAME=LeaderboardX
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:9020,http://127.0.0.1:9020

POSTGRES_DB=leaderboardx_db
POSTGRES_USER=sample_username
POSTGRES_PASSWORD=sample_password
DATABASE_URL=postgresql+asyncpg://sample_username:sample_password@postgres-service:5432/leaderboardx_db
REDIS_URL=redis://redis-service:6379

# Optional admin credentials for dashboard auth (not yet wired)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong
