APP_NAME=LeaderboardX
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_HOSTS=leaderboardx.patwari.com
CORS_ORIGINS=https://leaderboardx.patwari.com,https://dashboard.patwari.com

POSTGRES_DB=leaderboardx_db
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=prod_pass
DATABASE_URL=postgresql+asyncpg://prod_user:prod_pass@postgres-service:5432/leaderboardx_db
REDIS_URL=redis://redis-service:6379

# Optional admin credentials for dashboard auth (not yet wired)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong
